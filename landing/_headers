# Cloudflare Workers static assets: response header overrides.
# The APK must not be sniffed as a generic binary; Android installers and
# browsers rely on the package MIME type for the download prompt.

/download/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="GlucoPilot-1.1.0.apk"
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=3600
