# Cloudflare Workers static assets: response header overrides.
# Each APK is listed by its own name so the download filename always matches the
# version being served; a wildcard here would rename an archived build.
# The package MIME type is what Android installers and browsers use for the
# download prompt, and nosniff keeps the file from being treated as a generic
# binary.
#
# HTML, CSS and JS revalidate on every request: the landing links its
# stylesheets with ?v=, so a cached document can never pair a new page with a
# stale stylesheet after a deploy.

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

/download/GlucoPilot-1.2.0.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="GlucoPilot-1.2.0.apk"
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=3600

/download/GlucoPilot-1.1.3.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="GlucoPilot-1.1.3.apk"
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=3600
