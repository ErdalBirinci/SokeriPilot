<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_REBIND_NOTIFICATION_LISTENER_SERVICE" />

    <!-- xDrip+ sends its broadcast with this permission; the receiver must hold it too. -->
    <uses-permission android:name="com.eveningoutpost.dexdrip.permissions.RECEIVE_BG_ESTIMATE" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!--
        Android 11+ package visibility: only known CGM apps are queried.
        QUERY_ALL_PACKAGES is not used; narrow scope for privacy and Play policy.
    -->
    <queries>
        <package android:name="com.eveningoutpost.dexdrip" />
        <package android:name="tk.glucodata" />
        <package android:name="com.bubblesoft.android.diabox" />

        <!-- FreeStyle LibreLink packages are separate per region -->
        <package android:name="com.freestylelibre.app.tr" />
        <package android:name="com.freestylelibre.app.gb" />
        <package android:name="com.freestylelibre.app.de" />
        <package android:name="com.freestylelibre.app.fr" />
        <package android:name="com.freestylelibre.app.it" />
        <package android:name="com.freestylelibre.app.es" />
        <package android:name="com.freestylelibre.app.us" />
        <package android:name="com.freestylelibre.app.in" />
        <package android:name="com.freestylelibre.app.br" />
        <package android:name="com.freestylelibre.app.ch" />
        <package android:name="com.freestylelibre.app.be" />
        <package android:name="com.freestylelibre.app.sa" />
        <package android:name="com.freestylelibre.app.nl" />
        <package android:name="com.freestylelibre.app.ca" />
        <package android:name="com.freestylelibre.app.au" />
        <package android:name="com.freestylelibre.app.nz" />
        <package android:name="com.freestylelibre3.app.us" />

        <package android:name="com.dexcom.g6" />
        <package android:name="com.dexcom.g7" />

        <!-- Health Connect provider, for the optional write-only export. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".SokeriPilotApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SokeriPilot"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".phone.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect shows this app's permission rationale. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <service
            android:name=".car.SokeriPilotCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!--
            Reads the glucose value out of whatever CGM app the user already runs
            (Dexcom, Libre, xDrip+, Juggluco, Diabox, Eversense…). The only setup is
            the one-time system notification-access grant; nothing is configured
            inside the source app and no data leaves the device.
        -->
        <service
            android:name=".data.CgmNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Keeps the CGM notification live while navigation or media is open.
            Android 14+ declares the "specialUse" type with the subtype description below.
        -->
        <service
            android:name=".monitor.GlucoseMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_glucose_monitoring_for_driver_awareness" />
        </service>

        <!-- "Mute 30 min" action in the notification; not exported. -->
        <receiver
            android:name=".notify.MuteAlertsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.sokeripilot.action.MUTE_ALERTS" />
            </intent-filter>
        </receiver>

        <!-- "Got it" on an urgent-low alert. -->
        <receiver
            android:name=".notify.AcknowledgeAlertsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.sokeripilot.action.ACKNOWLEDGE_ALERT" />
            </intent-filter>
        </receiver>

        <!-- "Sensor change" on the stale-data reminder. -->
        <receiver
            android:name=".notify.SensorChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.sokeripilot.action.SENSOR_CHANGE" />
            </intent-filter>
        </receiver>

        <!--
            Must be exported to receive the xDrip+ broadcast. Incoming values are
            validated for range and timestamp in XDripReadingMapper.
        -->
        <receiver
            android:name=".data.XDripBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.eveningoutpost.dexdrip.BgEstimate" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
